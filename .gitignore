# Environment — never commit
.env
*.env
# `*.env` does NOT match a file named `.env.llm-panel` — it needs its own line.
# The .example template stays committed; gitignore matches path components
# exactly, so this pattern does not cover `.env.llm-panel.example`.
.env.llm-panel

# LLM panel run artifacts (transcripts, surveys, reasoning logs)
scripts/llm_panel/runs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node — not used in this project
node_modules/
package-lock.json
package.json

# Claude Code local config
.claude/

# Editors
.vscode/
.idea/
*.swp
