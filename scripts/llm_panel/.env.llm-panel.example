# Copy to .env.llm-panel and fill in. .env.llm-panel is gitignored; this
# template is committed.
#
#   cp .env.llm-panel.example .env.llm-panel
#   python -m llm_panel.seed
#
# The seed appends a generated token block to .env.llm-panel and rewrites it on
# every run. Everything you write above that block is preserved.

# Where the platform is running. Staging first — always.
LLM_PANEL_BASE_URL=http://localhost:8000

# A platform-admin JWT. Sign in as a platform_admin user and copy the token, or
# mint one with llm_panel.jwt_util against that user's supabase_uid.
# Needed for: POST /communities, POST /communities/{slug}/members.
LLM_PANEL_ADMIN_JWT=

# Same value as the backend's SUPABASE_JWT_SECRET for the environment you are
# seeding. Bot users never touch Supabase Auth, so the panel signs their tokens
# itself with this secret. Staging and production secrets differ — a token
# minted for one will 401 against the other.
SUPABASE_JWT_SECRET=

# --- Sprint 2 (provider keys) ------------------------------------------------
# Unused by the seed. Listed here so there is one file to fill in.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
